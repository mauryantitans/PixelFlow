# Application Settings
DEBUG=False
APP_NAME=PixelFlow
VERSION=1.2.0

# Server Settings
HOST=0.0.0.0
PORT=8000

# Database Settings
# For PostgreSQL (Production):
DATABASE_URL=postgresql://username:password@localhost:5432/pixelflow
USE_SQLITE=False

# For SQLite (Development):
# USE_SQLITE=True

# Image storage: "database" (default) or "s3" (AWS S3 / Cloudflare R2 / MinIO, private bucket)
# STORAGE_BACKEND=s3
# S3_BUCKET=pixelflow-images
# S3_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_PREFIX=pixelflow/

# Security
SECRET_KEY=your-super-secret-key-change-this-in-production
# Token lifetimes (30 min / 7 days) are constants in app/core/security_config.py.

# First admin, created on startup if no admin exists (no default credentials)
# ADMIN_EMAIL=you@example.com
# ADMIN_PASSWORD=a-strong-password

# Behind proxies: how many append to X-Forwarded-For (2 = Vercel rewrite + Render)
# TRUSTED_PROXY_HOPS=2

# Auth cookies (httpOnly cookie-based auth). Defaults are fine for local dev
# (Secure off under DEBUG, SameSite=Lax). In production set COOKIE_SECURE=True and
# serve the frontend same-origin with the API (see deployment/DEPLOYMENT_GUIDE.md).
# COOKIE_SECURE=True
# COOKIE_SAMESITE=lax
# COOKIE_DOMAIN=

# CORS Origins (comma-separated). NOTE: the env var is ALLOWED_ORIGINS.
ALLOWED_ORIGINS=http://localhost:3000
# For production, add your frontend domain:
# ALLOWED_ORIGINS=http://localhost:3000,https://your-frontend-domain.com
# Optional regex for Vercel preview URLs:
# ALLOWED_ORIGINS_REGEX=https://your-app(-[a-z0-9]+)*\.vercel\.app

# Google OAuth (Optional - uncomment and configure if using)
# GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=your-google-client-secret
# GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback
# For production, update redirect URI:
# GOOGLE_REDIRECT_URI=https://your-frontend-domain.com/auth/google/callback

# Email (password reset + email verification). "console" (default) only logs
# each message, link included, so local dev needs no mail provider.
# EMAIL_BACKEND=smtp
# SMTP_HOST=smtp.your-provider.com
# SMTP_PORT=587
# SMTP_USERNAME=your-smtp-username
# SMTP_PASSWORD=your-smtp-password
# SMTP_STARTTLS=True
# EMAIL_FROM=PixelFlow <no-reply@your-domain.com>
# Links in emails open the frontend (the Vercel URL in production):
# FRONTEND_URL=http://localhost:3000

# Full reference: deployment/ENVIRONMENT_VARIABLES.md
